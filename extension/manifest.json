{
    "manifest_version": 3,
    "name": "Study Shield",
    "version": "1.0",
    "description": "Block distracting websites during study sessions.",

    "permissions": [
        "tabs",
        "storage"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],

    "action": {
        "default_title": "Study Shield"
    }
}